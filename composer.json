{
    "name": "coda/taches",
    "description": "API de gestion de tâches (cours assisté GitLab CI/CD)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "lint": "phpcs",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration"
    },
    "config": {
        "platform": { "php": "8.3.0" },
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "11.5",
        "squizlabs/php_codesniffer": "3.11"
    }
}
